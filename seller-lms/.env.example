PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/lms.db

# dev = email-only login (local only!). header = trust an SSO proxy header (e.g. oauth2-proxy + Okta).
AUTH_MODE=dev
TRUSTED_EMAIL_HEADER=x-forwarded-email
SESSION_SECRET=change-me
# Comma-separated emails that are always admins (created on startup if missing).
ADMIN_EMAILS=

# Slack (optional; everything Slack-related is skipped when the token is unset)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ANNOUNCE_CHANNEL=
# Send reminders from inside the server every N hours (0 = off; prefer a daily `npm run reminders`).
REMINDER_INTERVAL_HOURS=0
